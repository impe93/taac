# macOS code-signing / notarization credentials for `pnpm build:mac`.
# Copy to `.env` and fill in your values. NEVER commit the real `.env`.
#
# electron-builder does not auto-load this file — export the vars before building:
#   set -a && source .env && set +a && pnpm build:mac
#
# The "Developer ID Application" certificate must be installed in your login
# keychain (electron-builder auto-detects the signing identity from it).

# Apple ID email used for notarization.
APPLE_ID=you@example.com

# App-specific password generated at https://appleid.apple.com (Sign-In & Security
# → App-Specific Passwords). NOT your normal Apple ID password.
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your 10-character Apple Developer Team ID (Membership page in the developer portal).
APPLE_TEAM_ID=ABCDE12345

# Optional: pin electron-builder's signing identity if you have several certs.
# IMPORTANT: no "Developer ID Application:" prefix — electron-builder picks the
# right cert TYPE automatically, so give only the common name + team.
# CSC_NAME=Your Name (ABCDE12345)
#
# The python-runtime deep-signing (scripts/afterPack.mjs) does NOT use CSC_NAME:
# it resolves the Developer ID Application cert by its SHA-1 hash automatically
# (unambiguous even if an Apple Development cert shares the same name). Override
# only if needed: TAAC_SIGN_IDENTITY=<40-char-sha1-hash>.

# ─────────────────────────────────────────────────────────────────────────────
# Calendar sync — OAuth client IDs (Google + Microsoft)
# ─────────────────────────────────────────────────────────────────────────────
# electron-vite exposes MAIN_VITE_* vars to the main process via import.meta.env
# (loaded from .env automatically in dev and build). If a provider's ID is unset,
# that provider is simply hidden in the UI — no crash.
#
# These are PUBLIC client IDs for DESKTOP (public) clients using PKCE: there is no
# client secret, and the ID is safe to embed in the build (extractable by design).
# Do NOT put any confidential-client secret here.
#
# Google  → Google Cloud Console → APIs & Services → Credentials →
#           OAuth client ID → Application type "Desktop app".
#           Enable the "Google Calendar API" and add the calendar.readonly scope
#           on the OAuth consent screen (add yourself as a Test user).
MAIN_VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Google "Desktop app" clients REQUIRE the client secret at the token endpoint,
# even with PKCE. Google documents it as NOT a real secret for installed apps
# (it ships inside the binary) — copy it from the same Credentials page as the
# client ID. Microsoft public clients use NO secret.
MAIN_VITE_GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Microsoft → Azure Portal → Microsoft Entra ID → App registrations → New.
#             Supported accounts: "any org directory + personal".
#             Authentication → add platform "Mobile and desktop applications",
#             redirect URI http://localhost, and "Allow public client flows = Yes".
#             API permissions (Delegated): Calendars.Read, offline_access,
#             openid, profile, email, User.Read.
MAIN_VITE_MICROSOFT_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: Azure tenant. Default 'common' (work + personal Microsoft accounts).
# MAIN_VITE_MICROSOFT_TENANT=common
